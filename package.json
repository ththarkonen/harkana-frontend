{
  "name": "frontend",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "bench:viewer-load": "node scripts/viewer-load-summary.mjs",
    "publish:cars": "node scripts/publish-ui.mjs cars",
    "publish:raman": "node scripts/publish-ui.mjs raman",
    "publish:hcars": "node scripts/publish-ui.mjs hcars",
    "publish:landing": "node scripts/publish-ui.mjs landing",
    "publish:uis": "node scripts/publish-ui.mjs uis",
    "publish:all": "node scripts/publish-ui.mjs all",
    "publish:dry-run": "node scripts/publish-ui.mjs all --dry-run",
    "gen2:typecheck": "pnpm --dir infra/amplify-gen2 run typecheck",
    "gen2:cars:sandbox": "pnpm --dir infra/amplify-gen2 run cars:sandbox",
    "gen2:hcars:sandbox": "pnpm --dir infra/amplify-gen2 run hcars:sandbox",
    "gen2:raman:sandbox": "pnpm --dir infra/amplify-gen2 run raman:sandbox"
  },
  "workspaces": [
    "apps/*",
    "infra/amplify-gen2",
    "packages/*"
  ]
}
